# ── Site ────────────────────────────────────────────────────────────
# Public URL, used for absolute link-preview (og:image) URLs.
# Optional on Vercel (falls back to the production domain).
NEXT_PUBLIC_SITE_URL=https://goodfirst.alpie.ai

# ── Supabase (live "N people here right now" presence counter) ──────
# Both optional — leave blank and the counter simply doesn't render.
# From your Supabase project: Settings → API. The anon key is safe to
# expose publicly (that's what NEXT_PUBLIC_ means).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Alpie (OpenAI-compatible chat completions) ──────────────────────
ALPIE_API_BASE=https://api.169pi.com/v1
ALPIE_API_KEY=
ALPIE_MODEL=alpie-32b

# ── GitHub OAuth app ────────────────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Must exactly match the OAuth app's "Authorization callback URL".
# Local: http://localhost:3001/api/auth/callback
GITHUB_REDIRECT_URI=https://goodfirst.alpie.ai/api/auth/callback

# Cookie signing. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Server-side token for the public repo stats AND the Clubs Leaderboard.
# Strongly recommended in production: raises the GitHub rate limit from 60/hr
# per IP to 5,000/hr. Without it the leaderboard can be blanked by rate limits
# (it then serves the last known standings, marked stale). A read-only /
# fine-grained token with public-repo read access is enough.
GITHUB_TOKEN=

# ── Repos (all optional; defaults shown) ────────────────────────────
# Star count, "Star" step and star auto-check
GITHUB_STARS_OWNER=169Pi
GITHUB_STARS_REPO=Alpie-Core
# PR count, contributor leaderboard
GITHUB_STATS_OWNER=169Pi
GITHUB_STATS_REPO=.github
# Fork / PR target used by the sign-in status check
GITHUB_PROFILE_OWNER=169Pi
GITHUB_PROFILE_REPO=.github

# Client-side copies used for links on the page
NEXT_PUBLIC_GITHUB_OWNER=169Pi
NEXT_PUBLIC_GITHUB_REPO=Alpie-Core
NEXT_PUBLIC_GITHUB_PROFILE_OWNER=169Pi
NEXT_PUBLIC_GITHUB_PROFILE_REPO=.github
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/GwJP7MsZp7
